{
    "name": "cauce/cauce",
    "description": "Cauce · Finanzas personales con método de presupuestación.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "minishlink/web-push": "^11.0",
        "monolog/monolog": "^3.7",
        "php-http/guzzle7-adapter": "^1.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "Cauce\\": "app/src/"
        },
        "classmap": [
            "app/config/database.php"
        ],
        "files": [
            "app/src/Helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Cauce\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public public/router.php",
        "test": "phpunit"
    }
}
