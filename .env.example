APP_NAME="Cauce"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Mexico_City
APP_SHARE_URL="https://cauce.app"
APP_VERSION="1.0.0"
MAIL_ENABLED=false
ONBOARDING_DEFAULT_INCOME_CENTS=1000000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cauce
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

LOG_PATH=storage/logs/app.log

# Web Push (Fase 6)
# Genera claves con: php -r 'require "vendor/autoload.php"; print_r(Minishlink\WebPush\VAPID::createVapidKeys());'
PUSH_ENABLED=false
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="https://cauce.app"
